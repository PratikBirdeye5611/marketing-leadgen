{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug LeadGen Dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--openssl-legacy-provider",
        "--import",
        "tsx"
      ],
      "args": ["src/index.ts"],
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "dev"
      },
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/**/*.ts"],
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}